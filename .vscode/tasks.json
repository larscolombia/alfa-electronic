		{
			"label": "LARS: ng serve",
			"type": "shell",
			"command": "npx ng serve",
			"options": {
				"cwd": "c:\\Users\\ludwi\\Desktop\\Proyectos\\LARS\\alfa-final\\themeforest-0dBIj6II-adminux-dashboard-responsive-html\\angular"
			},
			"isBackground": true,
			"problemMatcher": [
