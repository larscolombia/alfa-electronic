# Database
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/pika?sslmode=disable

# Server
PORT=8080

# JWT auth
# JWT_SECRET es OBLIGATORIO desde la Fase 2b: sin el valor el servidor no arranca
# (se elimino el secreto de desarrollo por defecto). Use un valor largo y aleatorio.
JWT_SECRET=cambia-esto-en-produccion
AUTH_ADMIN_EMAIL=admin@alfa.com
AUTH_ADMIN_PASSWORD=1234
AUTH_ADMIN_NAME=Administrador PIKA
AUTH_ADMIN_ROLE=admin

# Fase 2b — identidad de usuario real (opcionales, tienen default)
# Empresa de la cuenta admin sembrada. Default: demo-company
AUTH_ADMIN_COMPANY_ID=demo-company
# Rol NO privilegiado que reciben los registros (signup) cuando ya existe algun
# usuario. Debe coincidir con un nombre de acl_roles de la empresa (Superadmin,
# ventas, Técnico son los seeds por defecto); si no coincide, el middleware ACL no
# le dara permisos (falla cerrado). Default: ventas.
# El primer usuario de una tabla users vacia nace admin (bootstrap anti-lockout).
AUTH_SIGNUP_ROLE=ventas
